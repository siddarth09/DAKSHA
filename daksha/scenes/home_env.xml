<mujoco model="daksha_home_env">
  <!-- DAKSHA bimanual loco-manipulation — Phase 0 home environment (no robot yet).
       Earth gravity (-9.81), NOT Mars. Swap placeholder geoms for real/converted
       assets (Lightwheel USD->mesh, RoboCasa, YCB, PartNet) as they come online. -->
  <compiler angle="radian" meshdir="../assets"/>

  <option integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <default class="wall">
      <geom type="box" rgba="0.85 0.83 0.78 1" group="0"/>
    </default>
    <default class="furniture">
      <geom type="box" rgba="0.55 0.38 0.24 1" friction="0.9 0.02 0.001"/>
    </default>
    <default class="target">
      <geom type="box" rgba="0.80 0.25 0.25 1" friction="1.0 0.05 0.002"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.6" rgb2="0.1 0.12 0.16"
             width="512" height="3072"/>
    <texture type="2d" name="groundtex" builtin="checker" mark="edge"
             rgb1="0.2 0.2 0.22" rgb2="0.28 0.28 0.30" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundmat" texture="groundtex" texuniform="true"
              texrepeat="6 6" reflectance="0.1"/>
    <material name="wallmat" rgba="0.85 0.83 0.78 1"/>
  </asset>

  <worldbody>
    <light name="ceiling" pos="0 0 2.8" dir="0 0 -1" directional="false"
           diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>

    <!-- floor -->
    <geom name="floor" type="plane" size="3 3 0.05" material="groundmat"/>

    <!-- room walls (3m x 3m room, 2.5m tall, 0.05 thick) -->
    <geom name="wall_n" class="wall" pos="0 3 1.25" size="3 0.05 1.25"/>
    <geom name="wall_s" class="wall" pos="0 -3 1.25" size="3 0.05 1.25"/>
    <geom name="wall_e" class="wall" pos="3 0 1.25" size="0.05 3 1.25"/>
    <geom name="wall_w" class="wall" pos="-3 0 1.25" size="0.05 3 1.25"/>

    <!-- work table: top at 0.75m, legs -->
    <body name="table" pos="0.9 0 0">
      <geom name="table_top" class="furniture" pos="0 0 0.75" size="0.5 0.4 0.03"/>
      <geom name="leg_1" class="furniture" pos="0.45 0.35 0.36" size="0.03 0.03 0.36"/>
      <geom name="leg_2" class="furniture" pos="-0.45 0.35 0.36" size="0.03 0.03 0.36"/>
      <geom name="leg_3" class="furniture" pos="0.45 -0.35 0.36" size="0.03 0.03 0.36"/>
      <geom name="leg_4" class="furniture" pos="-0.45 -0.35 0.36" size="0.03 0.03 0.36"/>
    </body>

    <!-- target object: wide + heavy enough to require BOTH hands.
         0.5 x 0.25 x 0.2 box, ~4 kg. Sits on the table. -->
    <body name="target_box" pos="0.9 0 0.88">
      <freejoint name="target_free"/>
      <geom name="target_geom" class="target" size="0.25 0.12 0.10" mass="4.0"/>
    </body>
  </worldbody>
</mujoco>
