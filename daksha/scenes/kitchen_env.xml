<mujoco model="daksha_kitchen_env">
  <!-- DAKSHA Phase 0 kitchen environment (no robot).
       Hand-authored MJCF primitives standing in for RoboCasa/YCB meshes until those
       are downloaded (network blocked in this shell). Real meshes swap into the three
       object bodies below without touching the room. Earth gravity (-9.81). -->
  <compiler angle="radian" meshdir="../assets" texturedir="../assets"/>
  <option integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.16 0.20 0.26 1"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <!-- collidable surfaces objects rest on -->
    <geom condim="3" friction="0.9 0.02 0.001"/>
    <default class="decor">
      <!-- non-colliding furniture visuals (save contacts; no robot yet) -->
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="object">
      <geom condim="4" friction="1.0 0.05 0.002" group="0"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.38 0.5" rgb2="0.08 0.10 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="tiletex" builtin="checker" mark="edge"
             rgb1="0.82 0.80 0.76" rgb2="0.70 0.68 0.64" markrgb="0.5 0.5 0.5"
             width="300" height="300"/>
    <material name="floor" texture="tiletex" texuniform="true" texrepeat="8 8" reflectance="0.15"/>
    <material name="wall" rgba="0.90 0.88 0.83 1"/>
    <material name="backsplash" rgba="0.75 0.80 0.85 1" reflectance="0.2"/>
    <material name="cabinet" rgba="0.86 0.84 0.80 1"/>
    <material name="cabinet_door" rgba="0.80 0.78 0.73 1"/>
    <material name="counter" rgba="0.18 0.18 0.20 1" reflectance="0.25"/>
    <material name="steel" rgba="0.72 0.74 0.77 1" reflectance="0.4"/>
    <material name="dark" rgba="0.12 0.12 0.13 1" reflectance="0.15"/>
    <material name="handle" rgba="0.30 0.30 0.32 1" reflectance="0.3"/>
    <!-- real robosuite object meshes + textures -->
    <mesh name="m_bottle" file="objects/robosuite/meshes/bottle.obj"/>
    <mesh name="m_can"    file="objects/robosuite/meshes/can.obj"/>
    <texture type="2d" name="t_glass"   file="objects/robosuite/textures/glass.png"/>
    <texture type="2d" name="t_soda"    file="objects/robosuite/textures/soda.png"/>
    <material name="m_glass"   texture="t_glass"   reflectance="0.4" texrepeat="5 5" texuniform="true"/>
    <material name="m_soda"    texture="t_soda"    reflectance="0.5" texrepeat="5 5" texuniform="true"/>
  </asset>

  <worldbody>
    <light name="ceiling1" pos="-0.8 0.5 2.6" dir="0 0 -1" diffuse="0.5 0.5 0.5"/>
    <light name="ceiling2" pos="1.0 0.5 2.6" dir="0 0 -1" diffuse="0.5 0.5 0.5"/>

    <!-- room shell: 4.2 x 4.2 m, 2.6 m tall -->
    <geom name="floor" type="plane" size="2.1 2.1 0.05" material="floor"/>
    <geom name="wall_n" class="decor" type="box" pos="0 2.1 1.3"  size="2.1 0.05 1.3" material="wall"/>
    <geom name="wall_e" class="decor" type="box" pos="2.1 0 1.3"  size="0.05 2.1 1.3" material="wall"/>
    <geom name="wall_w" class="decor" type="box" pos="-2.1 0 1.3" size="0.05 2.1 1.3" material="wall"/>
    <geom name="wall_s" class="decor" type="box" pos="0 -2.1 1.3" size="2.1 0.05 1.3" material="wall"/>
    <!-- backsplash strip on the north wall behind the counter -->
    <geom name="backsplash" class="decor" type="box" pos="0 2.04 1.15" size="1.85 0.01 0.22" material="backsplash"/>

    <!-- ======================= BASE CABINETS ======================= -->
    <!-- carcass along north wall -->
    <geom name="base_carcass" class="decor" type="box" pos="0 1.72 0.44" size="1.85 0.30 0.44" material="cabinet"/>
    <!-- door panels + handles (front face y=1.42) -->
    <geom name="door_1" class="decor" type="box" pos="-1.35 1.415 0.45" size="0.28 0.008 0.38" material="cabinet_door"/>
    <geom name="door_2" class="decor" type="box" pos="-0.55 1.415 0.45" size="0.28 0.008 0.38" material="cabinet_door"/>
    <geom name="door_3" class="decor" type="box" pos="0.55 1.415 0.45"  size="0.28 0.008 0.38" material="cabinet_door"/>
    <geom name="door_4" class="decor" type="box" pos="1.35 1.415 0.45"  size="0.28 0.008 0.38" material="cabinet_door"/>
    <geom name="h1" class="decor" type="capsule" fromto="-1.15 1.41 0.30 -1.15 1.41 0.55" size="0.008" material="handle"/>
    <geom name="h2" class="decor" type="capsule" fromto="-0.35 1.41 0.30 -0.35 1.41 0.55" size="0.008" material="handle"/>
    <geom name="h3" class="decor" type="capsule" fromto=" 0.35 1.41 0.30  0.35 1.41 0.55" size="0.008" material="handle"/>
    <geom name="h4" class="decor" type="capsule" fromto=" 1.15 1.41 0.30  1.15 1.41 0.55" size="0.008" material="handle"/>

    <!-- ======================= COUNTERTOP ======================= -->
    <!-- split into 4 slabs to leave a rectangular sink hole around x[-1.5,-0.9] y[1.55,1.9] -->
    <geom name="counter_right" type="box" pos="0.475 1.70 0.90" size="1.375 0.32 0.03" material="counter"/>
    <geom name="counter_left"  type="box" pos="-1.675 1.70 0.90" size="0.175 0.32 0.03" material="counter"/>
    <geom name="counter_front" type="box" pos="-1.20 1.465 0.90" size="0.30 0.085 0.03" material="counter"/>
    <geom name="counter_back"  type="box" pos="-1.20 1.96 0.90"  size="0.30 0.06 0.03" material="counter"/>

    <!-- ======================= SINK ======================= -->
    <geom name="sink_bottom" type="box" pos="-1.20 1.725 0.72" size="0.28 0.165 0.01" material="steel"/>
    <geom name="sink_wl" type="box" pos="-1.49 1.725 0.81" size="0.01 0.165 0.09" material="steel"/>
    <geom name="sink_wr" type="box" pos="-0.91 1.725 0.81" size="0.01 0.165 0.09" material="steel"/>
    <geom name="sink_wf" type="box" pos="-1.20 1.565 0.81" size="0.28 0.01 0.09"  material="steel"/>
    <geom name="sink_wb" type="box" pos="-1.20 1.885 0.81" size="0.28 0.01 0.09"  material="steel"/>
    <!-- faucet -->
    <geom name="faucet_stem" class="decor" type="capsule" fromto="-1.20 1.97 0.93 -1.20 1.97 1.18" size="0.012" material="steel"/>
    <geom name="faucet_arm"  class="decor" type="capsule" fromto="-1.20 1.97 1.18 -1.20 1.80 1.14" size="0.011" material="steel"/>

    <!-- ======================= COOKTOP ======================= -->
    <geom name="cooktop" class="decor" type="box" pos="1.25 1.70 0.935" size="0.36 0.28 0.006" material="dark"/>
    <geom name="burner_1" class="decor" type="cylinder" pos="1.08 1.55 0.942" size="0.075 0.003" material="handle"/>
    <geom name="burner_2" class="decor" type="cylinder" pos="1.42 1.55 0.942" size="0.075 0.003" material="handle"/>
    <geom name="burner_3" class="decor" type="cylinder" pos="1.08 1.85 0.942" size="0.075 0.003" material="handle"/>
    <geom name="burner_4" class="decor" type="cylinder" pos="1.42 1.85 0.942" size="0.075 0.003" material="handle"/>

    <!-- ======================= UPPER CABINETS ======================= -->
    <geom name="upper_left"  class="decor" type="box" pos="-1.1 1.87 1.85" size="0.75 0.17 0.28" material="cabinet"/>
    <geom name="upper_right" class="decor" type="box" pos="1.4 1.87 1.85"  size="0.42 0.17 0.28" material="cabinet"/>
    <!-- range hood above the cooktop -->
    <geom name="hood" class="decor" type="box" pos="1.25 1.90 1.72" size="0.40 0.14 0.10" material="steel"/>
    <geom name="hood_duct" class="decor" type="box" pos="1.25 2.00 2.05" size="0.10 0.04 0.25" material="steel"/>

    <!-- ======================= REFRIGERATOR ======================= -->
    <geom name="fridge_body" class="decor" type="box" pos="1.62 -1.2 0.95" size="0.36 0.36 0.95" material="steel"/>
    <geom name="fridge_door_gap" class="decor" type="box" pos="1.25 -1.2 0.95" size="0.005 0.34 0.93" material="dark"/>
    <geom name="fridge_h1" class="decor" type="capsule" fromto="1.28 -1.55 0.7 1.28 -1.55 1.4" size="0.012" material="handle"/>
    <geom name="fridge_h2" class="decor" type="capsule" fromto="1.28 -0.85 0.7 1.28 -0.85 1.4" size="0.012" material="handle"/>

    <!-- ======================= OBJECTS (graspable, dynamic) =======================
         Real robosuite meshes (convex-hull collision). Counter top surface z=0.93.
         Drop-in point for richer RoboCasa/YCB meshes later. -->

    <!-- 1) BOTTLE -->
    <body name="obj_bottle" pos="-0.25 1.72 1.00">
      <freejoint name="bottle_free"/>
      <geom name="bottle_geom" class="object" type="mesh" mesh="m_bottle" material="m_glass" density="300"/>
    </body>

    <!-- 2) SODA CAN -->
    <body name="obj_can" pos="0.10 1.70 0.98">
      <freejoint name="can_free"/>
      <geom name="can_geom" class="object" type="mesh" mesh="m_can" material="m_soda" density="120"/>
    </body>

  </worldbody>
</mujoco>
