  <ros2_control name="ZeroVx300sSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find zero_description)/mjcf/zero_vx300s.xml</param>
      <param name="sim_speed_factor">1.0</param>
      <param name="camera_publish_rate">30.0</param>
      <param name="override_start_position_file">/tmp/zero_vx300s_start.xml</param>
      <param name="initial_keyframe">home</param>
    </hardware>
    <joint name="left_waist">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_shoulder">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
