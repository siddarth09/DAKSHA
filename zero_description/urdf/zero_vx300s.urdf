      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_forearm_roll">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_wrist_angle">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_wrist_rotate">
      <command_interface name="position" />
