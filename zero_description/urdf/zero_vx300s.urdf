    <sensor name="front">
      <param name="frame_name">front_optical_frame</param>
      <param name="image_topic">/zero/front/image_raw</param>
      <param name="info_topic">/zero/front/camera_info</param>
      <param name="depth_topic">/zero/front/depth</param>
    </sensor>
    <sensor name="left_wrist">
