<!-- HANUMAN: Mars scene for mujoco_ros2_control
     Includes G1 robot + Mars base terrain.
     This file is what the mujoco_model param points to.
-->
<mujoco model="hanuman_mars_scene">
  <include file="g1_mars.xml"/>

  <!-- Override gravity for Mars -->
  <option gravity="0 0 -9.81" timestep="0.001"/>

  <statistic center="0 0 0.8" extent="2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.2 0.1" specular="0.5 0.5 0.5"/>
    <rgba haze="0.6 0.35 0.15 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.55 0.35" rgb2="0.35 0.15 0.05"
      width="512" height="3072"/>

    <mesh name="mars_base_terrain"
        file="../../model/mars_base/meshes/mars_base.obj"
        scale="1.0 1.0 1.0"/>
  </asset>

  <worldbody>
    <light pos="2 -2 5" dir="-0.3 0.3 -1" directional="true" diffuse="0.9 0.7 0.5"/>
    <light pos="-2 2 4" dir="0.3 -0.3 -1" directional="true" diffuse="0.3 0.2 0.1"/>

    <!-- Invisible collision floor at terrain surface height -->
    <geom name="ground" type="plane" size="50 50 0.1" pos="0 0 0"
      rgba="0 0 0 0" friction="1.0 0.005 0.0001" condim="6"/>

    <!-- Mars base terrain (visual only) -->
    <body name="mars_terrain" pos="0 0 -0.4" euler="1.5708 0 0">
      <geom name="mars_terrain" type="mesh" mesh="mars_base_terrain"
            friction="1.0 0.005 0.0001" condim="6" rgba="0.72 0.45 0.2 1"
            contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
